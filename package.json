{
  "name": "weekly-todo",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:netlify": "netlify dev --filter client",
    "build": "npm run build -w client",
    "build:netlify": "netlify build --filter client",
    "deploy": "netlify deploy --filter client",
    "deploy:prod": "netlify deploy --filter client --prod"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
